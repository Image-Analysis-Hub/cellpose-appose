<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.scijava</groupId>
		<artifactId>pom-scijava</artifactId>
		<version>44.0.0</version>
		<relativePath />
	</parent>

	<groupId>fiji.plugin</groupId>
	<artifactId>Cellpose_Appose</artifactId>
	<version>0.1.9-SNAPSHOT</version>

	<name>cellpose-appose</name>
	<description> Running Cellpose with a Fiji plugin based on Appose.</description>
	<url>http://mycompany.com/imagej/bio-formats-reader/</url>
	<inceptionYear>2026</inceptionYear>
	<organization>
		<name>My Company</name>
		<url>http://mycompany.com/</url>
	</organization>
	<licenses>
		<license>
			<name>BSD-3-clause</name>
			<url>https://opensource.org/license/bsd-3-clause/</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>StRigaud</id>
			<name>Stephane Rigaud</name>
			<url>https://github.com/StRigaud</url>
			<roles>
				<role>developer</role>
				<role>maintainer</role>
			</roles>
		</developer>
		<developer>
			<id>gletort</id>
			<name>Gaelle Letort</name>
			<url>https://github.com/gletort</url>
			<roles>
				<role>developer</role>
				<role>maintainer</role>
			</roles>
		</developer>
		<developer>
			<id>your-id-here</id>
			<name>Your Name Here</name>
			<url>http://imagej.net/User:YourWikiUsername</url>
			<roles>
				<role>founder</role>
				<role>lead</role>
				<role>developer</role>
				<role>debugger</role>
				<role>reviewer</role>
				<role>support</role>
				<role>maintainer</role>
			</roles>
		</developer>
	</developers>

	<contributors>
		<contributor>
			<name>Someone Who Contributed</name>
			<url>http://imagej.net/User:TheirWikiUsername</url>
			<properties>
				<id>their-id</id>
			</properties>
		</contributor>
	</contributors>

	<mailingLists>
		<mailingList>
			<name>ImageJ Forum</name>
			<archive>https://forum.image.sc/</archive>
		</mailingList>
	</mailingLists>

	<scm>
		<connection>scm:git:git://github.com/Image-Analysis-Hub/cellpose-appose</connection>
		<developerConnection>
			scm:git:git@github.com:Image-Analysis-Hub/cellpose-appose</developerConnection>
		<url>https://github.com/Image-Analysis-Hub/cellpose-appose</url>
	</scm>

	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/Image-Analysis-Hub/cellpose-appose/issues</url>
	</issueManagement>
	<ciManagement>
		<system>None</system>
	</ciManagement>

	<properties>
		<package-name>fiji.plugin.appose.cellpose</package-name>
		<main-class>fiji.plugin.appose.cellpose.CellposeAppose</main-class>
		<license.licenseName>bsd_3</license.licenseName>
		<license.copyrightOwners>Appose developpers</license.copyrightOwners>

		<!-- Use Java 21. -->
		<scijava.jvm.version>21</scijava.jvm.version>
		<scijava.jvm.build.version>[21,)</scijava.jvm.build.version>

		<imglib2-appose.version>0.9.0</imglib2-appose.version>
		<appose.version>0.11.0</appose.version>
	</properties>


	<dependencies>
		<!-- ImageJ 1.x dependency -->
		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>ij</artifactId>
		</dependency>

		<dependency>
			<groupId>org.apposed</groupId>
			<artifactId>appose</artifactId>
			<version>${appose.version}</version>
		</dependency>

		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>config-ui-fiji</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>

		<!-- ImgLib2 dependencies -->
		<dependency>
			<groupId>net.imglib2</groupId>
			<artifactId>imglib2-appose</artifactId>
			<version>${imglib2-appose.version}</version>
		</dependency>

		<dependency>
			<groupId>net.imglib2</groupId>
			<artifactId>imglib2-ij</artifactId>
		</dependency>

		<dependency>
			<groupId>net.imglib2</groupId>
			<artifactId>imglib2-cellpose</artifactId>
			<version>0.0.5-SNAPSHOT</version>
		</dependency>

		<!-- Test dependencies -->
		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>imagej</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>


	<repositories>
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/groups/public</url>
		</repository>
	</repositories>

	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<excludes>
					<exclude>__pycache__/*</exclude>
					<exclude>.pixi/**</exclude>
					<exclude>.mypy_cache</exclude>
				</excludes>
			</resource>
		</resources>
	</build>
</project>
